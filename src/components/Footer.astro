---
import { url } from '../lib/url';
import { site } from '../lib/site';
const { email, linkedin, resume } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="wrap inner">
    <div>
      <h2>{site.contact_heading}</h2>
      {site.contact_text && <p>{site.contact_text}</p>}
    </div>
    <ul class="links">
      {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
      {linkedin && <li><a href={linkedin}>LinkedIn</a></li>}
      {resume && <li><a href={url(resume)}>Resume (PDF)</a></li>}
    </ul>
  </div>
  <div class="wrap fine">© {year} {site.name}</div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 0;
    padding-block: clamp(3rem, 8vw, 5rem) 2rem;
  }
  .inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: end;
  }
  h2 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    color: var(--gold);
    margin-bottom: 0.75rem;
  }
  p {
    color: var(--muted);
    max-width: 44ch;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .fine {
    margin-top: 3rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
