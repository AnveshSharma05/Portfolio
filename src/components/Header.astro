---
import { url } from '../lib/url';
import { site } from '../lib/site';
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#proudest', label: 'Proudest' },
  ...(site.resume ? [{ href: site.resume, label: 'Resume' }] : []),
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href={url('/')}>{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--black) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .mark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--gold);
    text-decoration: none;
    white-space: nowrap;
  }
  ul {
    display: flex;
    gap: clamp(0.9rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--gold);
  }
  nav a {
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .mark {
      font-size: 1rem;
    }
    nav a {
      font-size: 0.8rem;
    }
    ul {
      gap: 0.7rem;
    }
  }
  @media (max-width: 380px) {
    .mark {
      font-size: 0.9rem;
    }
    ul {
      gap: 0.55rem;
    }
  }
</style>
