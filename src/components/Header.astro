---
import { url } from '../lib/url';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
const used = new Set((await getCollection('projects')).map((p) => p.data.section));
const links = [
  ...(used.has('projects') ? [{ href: '/#projects', label: 'Projects' }] : []),
  ...(used.has('in-progress') ? [{ href: '/#in-progress', label: 'In progress' }] : []),
  ...(used.has('work') ? [{ href: '/#work', label: 'Work' }] : []),
  ...(site.resume ? [{ href: site.resume, label: 'Resume' }] : []),
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href={url('/')}>{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--black) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .mark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--gold);
    text-decoration: none;
    white-space: nowrap;
  }
  ul {
    display: flex;
    gap: clamp(0.9rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--gold);
  }
  nav a {
    white-space: nowrap;
  }
  /* Small screens: name on top, menu on its own row underneath */
  @media (max-width: 640px) {
    .bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      padding-block: 0.6rem;
      min-height: 0;
    }
    .mark {
      font-size: 1.05rem;
    }
    nav {
      width: 100%;
    }
    ul {
      justify-content: space-between;
      gap: 0.5rem;
    }
    nav a {
      font-size: 0.85rem;
    }
  }
  @media (max-width: 360px) {
    nav a {
      font-size: 0.78rem;
    }
  }
</style>
