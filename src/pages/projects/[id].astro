---
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  // Walk through the regular projects first, then the proudest ones, same as the home page
  const ordered = [...all.filter((p) => !p.data.proudest), ...all.filter((p) => p.data.proudest)];
  return ordered.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: ordered[(i + 1) % ordered.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const facts = [
  ['Role', d.role],
  ['Team', d.team],
  ['Timeline', d.timeline],
  ['Tools', d.tools],
].filter(([, v]) => v);
---

<Base title={d.title} description={d.summary}>
  <article class="wrap project">
    <a class="back" href={url(d.proudest ? '/#proudest' : '/#projects')}>Back to all projects</a>

    <header class="head">
      <p class="cat">{d.proudest ? `${d.category}, one of my proudest projects` : d.category}</p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>

    {facts.length > 0 && (
      <dl class="facts">
        {facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    )}

    <figure class="cover">
      <img src={url(d.image)} alt={d.imageAlt} width="1600" height="1000" />
    </figure>

    <div class="prose">
      <Content />
    </div>

    <nav class="next" aria-label="Next project">
      <span>Next project</span>
      <a href={url(`/projects/${next.id}/`)}>{next.data.title}</a>
    </nav>
  </article>
</Base>

<style>
  .project {
    padding-block: 2.5rem 5rem;
  }
  .back {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .head {
    margin-block: clamp(2rem, 6vw, 3.5rem) 2rem;
    max-width: 52rem;
  }
  .cat {
    color: var(--purple);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 400;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }
  .summary {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    max-width: 40ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.25rem 2rem;
    margin: 0 0 2.5rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
  }
  dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  dd {
    margin: 0.15rem 0 0;
  }
  .cover {
    margin: 0 0 clamp(2.5rem, 6vw, 4rem);
  }
  .cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--gold-deep);
    border-radius: var(--radius);
  }

  /* Text written in the project's .md file */
  .prose {
    max-width: 68ch;
    margin-inline: auto;
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-size: 1.9rem;
    color: var(--gold);
    margin: 2.5rem 0 0.9rem;
  }
  .prose :global(h3) {
    font-size: 1.35rem;
    margin: 2rem 0 0.6rem;
  }
  /* Images in the writeup: never wider than the text, never taller than
     about a screen, centered. Small images stay at their natural size. */
  .prose :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(560px, 80vh);
    object-fit: contain;
    margin: 2rem auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  /* Optional sizes: end an image's description (alt text) with | small, | medium or | full */
  .prose :global(img[alt$='| small']) {
    width: 40%;
  }
  .prose :global(img[alt$='| medium']) {
    width: 65%;
  }
  .prose :global(img[alt$='| full']) {
    width: 100%;
    max-height: none;
  }
  @media (max-width: 560px) {
    .prose :global(img[alt$='| small']) {
      width: 70%;
    }
    .prose :global(img[alt$='| medium']) {
      width: 100%;
    }
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose :global(li::marker) {
    color: var(--gold);
  }
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--purple);
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--text);
  }

  .next {
    max-width: 68ch;
    margin: clamp(3.5rem, 8vw, 5rem) auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.25rem;
  }
  .next span {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .next a {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    text-decoration: none;
  }
  .next a:hover {
    text-decoration: underline;
    text-decoration-color: var(--purple);
  }
</style>
